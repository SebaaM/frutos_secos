# Backend (variables del proceso Django)
DJANGO_SECRET_KEY=replace-with-a-unique-local-secret
DJANGO_DEBUG=true
BACKOFFICE_ENABLED=true
DATABASE_URL=postgresql://rosana:rosana@localhost:5432/rosana_frutos_secos

# Frontend
# Vite usa proxy a Django en desarrollo. En producción configurar reverse proxy.
VITE_API_BASE_URL=/api/v1
VITE_WHATSAPP_NUMBER=5490000000000

# Acceso y email. Django lee estas variables desde el proceso; no carga .env solo.
# ConsoleEmailBackend muestra enlaces en la terminal, no envía emails reales.
FRONTEND_URL=http://localhost:8443
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Rosana <no-reply@example.invalid>
# Para envío real, usar django.core.mail.backends.smtp.EmailBackend y configurar:
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
CUSTOMER_LINK_MINUTES=15
CUSTOMER_SESSION_DAYS=7

# Calendario provisional: lunes=0, sábado=5. Confirmar antes de automatizar.
ORDER_RESERVATION_HOURS=48
ORDER_BUSINESS_DAYS=0,1,2,3,4,5
ORDER_BUSINESS_OPEN_HOUR=9
ORDER_BUSINESS_CLOSE_HOUR=19
ORDER_AUTO_EXPIRE_ENABLED=false
